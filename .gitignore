# Claude Code settings (local)
.claude/settings.local.json

# NOTE: web/js/shared/ is a generated copy of shared/js/ (source of truth), but it IS
# committed on purpose: playground.madola.org is deployed from a plain git checkout
# (Vercel), so anything gitignored here 404s in production. After editing shared/js/,
# run `npm run sync-shared` and commit the regenerated copies alongside it.

# Dependencies
node_modules/
**/node_modules/
vendor/*
!vendor/tree-sitter/

# Build outputs
dist/
build/
build-wasm/
build_wasm/
gen_cpp/
target/

# Compiled files
*.o
*.so
*.dll
*.exe
*.obj
*.wasm
*.js.map
*.gch
*.pch
*.exp
*.lib
*.a

# Allow web/runtime/*.js (WASM runtime files)
!web/runtime/*.js
!web/runtime/*.wasm

# Logs and temp files
*.log
*.tmp
*.cache
*.swp
*.swo
.DS_Store


# C++ and WASM files are now stored in ~/.madola/gen_cpp and ~/.madola/trove
trove/

# Temporary and output files
*.hml
out.hml
test_inline.mda

# Distribution folders
electron/dist/
tauri/target/

# VS Code extension builds
.vscode/extensions/**/out/
.vscode/extensions/**/*.vsix
.vscode/extensions/**/node_modules/

# Regression test results (generated)
regression/results/
regression/diff/
regression/temp/

# Private editor directory (not tracked)
editor/
app/

